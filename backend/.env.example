# Backend environment variables — copy to .env and fill in values.
# NEVER commit .env to source control.

# ── Firebase ────────────────────────────────────────────────────────────────
# Path to your Firebase service-account JSON key file.
# Download from Firebase Console → Project Settings → Service Accounts.
FIREBASE_CREDENTIALS_PATH=./firebase_credentials.json

# ── OpenRouter ──────────────────────────────────────────────────────────────
# API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Model to use via OpenRouter (default: deepseek/deepseek-chat).
# Change this to swap models without touching code.
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731

# ── Rate limits (optional overrides) ────────────────────────────────────────
# RATE_LIMIT_MESSAGES_PER_CHAT=50
# RATE_LIMIT_CHATS_PER_USER_PER_DAY=20

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
